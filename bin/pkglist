#!/usr/bin/env bash
# pkglist <host> [--aur]
# Print the package names in a host's lists, one per line, with the notes,
# comments and blank lines stripped.
# Usage:
#   pkglist rocinante        repo packages: every list in pkg/ but aur.txt
#   pkglist rocinante --aur  foreign packages: aur.txt

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

usage() {
	printf 'usage: pkglist <host> [--aur]\n' >&2
	exit 2
}

(( $# == 1 )) || { (( $# == 2 )) && [[ $2 == --aur ]]; } || usage
dir=$here/hosts/$1/pkg
[[ -d $dir ]] || { printf 'pkglist: no manifest for host %s\n' "$1" >&2; exit 2; }

files=()
for file in "$dir"/*.txt; do
	[[ -f $file ]] || continue
	if [[ ${file##*/} == aur.txt ]]; then
		(( $# == 1 )) || files+=("$file")
	else
		(( $# == 2 )) || files+=("$file")
	fi
done
(( ${#files[@]} )) || exit 0

# A line is a name, then an optional `# note`.
sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "${files[@]}"
